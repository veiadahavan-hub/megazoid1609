# ═══════════════════════════════════════════════════════════════════════
# AI STUDIO PRO — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com suas credenciais

# ─── Servidor ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://seu-dominio.com

# ─── Redis (BullMQ) ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=  # Descomente se Redis tiver senha

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── APIs de Geração (Opcional — modo BYOK) ─────────────────────────
# SDXL API (para gerar imagens)
SDXL_API_URL=https://api.stability.ai
SDXL_API_KEY=sk-xxxxx

# ElevenLabs (para narração TTS)
ELEVENLABS_API_KEY=xxxxx
ELEVENLABS_VOICE_ID=xxxxx

# OpenAI Whisper (para transcrição + timestamps)
OPENAI_API_KEY=sk-xxxxx

# ─── Paths ───────────────────────────────────────────────────────────
RENDERS_DIR=/renders/final
TEMP_DIR=/tmp/renders
LOTTIE_CACHE_DIR=/tmp/lottie_cache

# ─── Limites ─────────────────────────────────────────────────────────
MAX_CONCURRENT_RENDERS=2
MAX_UPLOAD_SIZE_MB=50
CLEANUP_MAX_AGE_DAYS=7
